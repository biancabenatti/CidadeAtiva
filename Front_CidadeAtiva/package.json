  "devDependencies": {
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.min.js"
