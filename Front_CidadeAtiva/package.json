{
  "name": "front_cidadeativa",
  "version": "1.0.0",
  "description": "Interface web do projeto Cidade Ativa, uma aplicação para registro e acompanhamento de ocorrências urbanas.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
